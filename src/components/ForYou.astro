---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { img } from '../lib/images';
import { disciplines, loveIt, notForYou, tenWords, letter, links } from '../content/opencall';
---
<section class="section section--sand foryou" id="for-you" aria-labelledby="foryou-title">
  <div class="container">
    <SectionHead nr="02" kicker="Is it for you?" id="foryou-title"
      title="Made for artists who want time, space and good company." />

    <div class="foryou__disciplines" data-reveal>
      <p class="label">Nocefresca is perfect for — but not limited to —</p>
      <div class="marquee-wrap">
        <div class="marquee" data-marquee tabindex="0" role="region" aria-label="Profiles Nocefresca is perfect for — scroll sideways">
          <div class="marquee__track">
            <ul class="disc" role="list">
              {disciplines.map((d) => <li>{d}</li>)}
            </ul>
            <ul class="disc" role="list" aria-hidden="true">
              {disciplines.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
        <button class="marquee__btn marquee__btn--prev" type="button" data-marquee-step="-1" aria-label="Previous profiles" tabindex="-1">←</button>
        <button class="marquee__btn marquee__btn--next" type="button" data-marquee-step="1" aria-label="Next profiles" tabindex="-1">→</button>
      </div>
      <p class="foryou__note">Solo artists, collectives and small groups. All ages can apply.</p>
    </div>

    <div class="foryou__cols">
      <div class="fit fit--yes" data-reveal>
        <h3>You’ll love it if you want to…</h3>
        <ul class="fit__list" role="list">
          {loveIt.map((l) => <li><strong>{l.title}.</strong> {l.text}</li>)}
        </ul>
      </div>
      <div class="fit fit--no" data-reveal style="--d:80ms">
        <h3>It might not be for you if…</h3>
        <ul class="fit__list" role="list">
          {notForYou.map((l) => <li><strong>{l.title}.</strong> {l.text}</li>)}
        </ul>
        <figure class="fit__quote">
          <blockquote><p class="quote">{letter.quotes.honest}</p></blockquote>
          <figcaption><a class="link" href={links.letterMakenzie} data-track="outbound_click" data-location="foryou_quote">{letter.author}</a>, {letter.role.toLowerCase()}</figcaption>
        </figure>
      </div>
      <figure class="foryou__img" data-reveal style="--d:140ms">
        <div class="media media--zoom">
          <Picture src={img('life/camera-hands.jpg')} formats={['webp']} widths={[400, 640, 900]} sizes="(min-width: 60rem) 25vw, 100vw" quality={70} alt="Close-up of hands holding a twin-lens film camera against patched denim." />
        </div>
      </figure>
    </div>

    <div class="acc foryou__acc" data-reveal>
      <details data-track="accordion_open" data-location="ten_words">
        <summary>Ten words that describe Nocefresca <span class="pm" aria-hidden="true"></span></summary>
        <div class="acc__body">
          <dl class="words">
            {tenWords.map((w) => <div><dt>{w.word}</dt><dd>{w.text}</dd></div>)}
          </dl>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .foryou__disciplines { margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem); }
  /* one-line marquee: auto-scrolls, and can be scrolled by hand (drag, trackpad, wheel, arrows, keyboard) */
  .foryou__disciplines { overflow: hidden; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
  .marquee-wrap { position: relative; margin: 0.75rem calc(var(--gutter) * -1) 0; }
  .marquee { overflow-x: auto; scrollbar-width: none; cursor: grab; overscroll-behavior-x: contain; }
  .marquee::-webkit-scrollbar { display: none; }
  .marquee.is-dragging { cursor: grabbing; user-select: none; }
  .marquee:focus-visible { outline-offset: -3px; }
  .marquee__track { display: flex; width: max-content; padding-inline: var(--gutter); }
  .disc { display: flex; flex: none; white-space: nowrap; font-family: var(--f-display); font-weight: 500; font-size: clamp(2rem, 1.3rem + 3vw, 4.25rem); line-height: 1.15; letter-spacing: -0.025em; color: var(--c-burgundy); }
  .disc li::after { content: '/'; margin: 0 0.4em; color: var(--c-terracotta); font-weight: 400; }
  .marquee__btn { position: absolute; top: 50%; transform: translateY(-50%); width: 3rem; height: 3rem; border-radius: 50%; background: var(--c-paper); color: var(--c-burgundy); box-shadow: 0 0 0 1px var(--c-line-strong), 0 8px 20px -10px rgb(62 31 34 / 0.4); font-size: 1.25rem; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
  .marquee__btn--prev { left: var(--gutter); } .marquee__btn--next { right: var(--gutter); }
  @media (hover: hover) { .marquee-wrap:hover .marquee__btn { opacity: 1; pointer-events: auto; } }
  .marquee__btn:hover { background: var(--c-white); }
  .foryou__note { margin-top: 1rem; font-size: var(--fs-lead); color: var(--c-ink); }

  .foryou__cols { display: grid; gap: var(--gap); }
  .fit { padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: var(--radius); }
  .fit h3 { font-size: var(--fs-h3); margin-bottom: 1.25rem; }
  .fit--yes { background: var(--c-paper); }
  .fit--no { background: transparent; box-shadow: inset 0 0 0 1.5px var(--c-line-strong); }
  .fit__list { display: grid; gap: 0.9rem; }
  .fit__list li { position: relative; padding-left: 1.75rem; font-size: var(--fs-small); line-height: 1.5; }
  .fit__list strong { font-family: var(--f-display); font-weight: 500; color: var(--c-burgundy); }
  .fit--yes .fit__list li::before { content: ''; position: absolute; left: 0.1rem; top: 0.35em; width: 0.85rem; height: 0.5rem; border-left: 2px solid var(--c-olive); border-bottom: 2px solid var(--c-olive); transform: rotate(-45deg); }
  .fit--no .fit__list li::before, .fit--no .fit__list li::after { content: ''; position: absolute; left: 0.05rem; top: 0.72em; width: 0.95rem; height: 2px; background: var(--c-burgundy); transform: rotate(45deg); }
  .fit--no .fit__list li::after { transform: rotate(-45deg); }
  .fit__quote { margin: 1.75rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--c-line); }
  .fit__quote .quote { font-size: 1.1875rem; }
  .fit__quote figcaption { margin-top: 0.6rem; font-family: var(--f-display); font-size: 0.875rem; color: var(--c-muted); }
  .foryou__img { margin: 0; }
  .foryou__img .media { aspect-ratio: 4 / 3; height: 100%; }
  .foryou__acc { margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .words { display: grid; gap: 1rem 2rem; }
  .words dt { font-family: var(--f-display); font-weight: 500; color: var(--c-burgundy); }
  .words dd { margin: 0.15rem 0 0; font-size: var(--fs-small); }
  @media (min-width: 40rem) { .words { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 60rem) {
    .foryou__cols { grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr); align-items: stretch; }
    .foryou__img .media { aspect-ratio: auto; min-height: 100%; }
    .words { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .foryou__acc .acc__body { max-width: none; }
  }
</style>

<script>
  // Auto-scroll that loops seamlessly; pauses while hovered/focused/touched so people can browse by hand.
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((el) => {
    const track = el.firstElementChild as HTMLElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const half = () => track.scrollWidth / 2;
    let paused = false, dragging = false, startX = 0, startLeft = 0, last = 0, offset = 0, halfW = half();
    const SPEED = 0.075; // px per ms ≈ 75 px/s
    const wrap = () => { const h = half(); if (el.scrollLeft >= h) el.scrollLeft -= h; else if (el.scrollLeft <= 0) el.scrollLeft += h; };
    // Auto-scroll moves the track with a sub-pixel GPU transform (smooth everywhere, Safari included);
    // when someone takes over, the offset is folded into the real scroll position.
    const fold = () => {
      if (!offset) return;
      const h = half();
      track.style.transform = '';
      el.scrollLeft = (((el.scrollLeft + offset) % h) + h) % h;
      offset = 0;
    };
    const tick = (t: number) => {
      const dt = last ? Math.min(t - last, 50) : 16; last = t;
      if (!paused && !dragging && !reduce) {
        offset += dt * SPEED;
        if (el.scrollLeft + offset >= halfW) offset -= halfW;
        track.style.transform = `translate3d(${-offset}px,0,0)`;
      }
      requestAnimationFrame(tick);
    };
    track.style.willChange = 'transform';
    new ResizeObserver(() => (halfW = half())).observe(track);
    requestAnimationFrame(tick);
    const pause = () => { paused = true; fold(); }, resume = () => (paused = false);
    el.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') pause(); });
    el.parentElement!.addEventListener('mouseleave', () => { if (!dragging) resume(); });
    el.addEventListener('focus', pause); el.addEventListener('blur', resume);
    el.addEventListener('touchstart', pause, { passive: true });
    el.addEventListener('touchend', () => setTimeout(resume, 2500), { passive: true });
    el.addEventListener('scroll', () => { if (paused || dragging) wrap(); }, { passive: true });
    // trackpads and Shift+wheel scroll the row natively; vertical wheel keeps scrolling the page
    // drag to scroll
    el.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; fold(); dragging = true; startX = e.clientX; startLeft = el.scrollLeft; el.classList.add('is-dragging'); el.setPointerCapture(e.pointerId); });
    el.addEventListener('pointermove', (e) => { if (!dragging) return; el.scrollLeft = startLeft - (e.clientX - startX); wrap(); startLeft = el.scrollLeft + (e.clientX - startX); });
    const end = () => { dragging = false; el.classList.remove('is-dragging'); };
    el.addEventListener('pointerup', end); el.addEventListener('pointercancel', end);
    el.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); el.scrollBy({ left: (e.key === 'ArrowRight' ? 1 : -1) * el.clientWidth * 0.5, behavior: 'smooth' }); } });
    el.parentElement!.querySelectorAll<HTMLButtonElement>('[data-marquee-step]').forEach((b) =>
      b.addEventListener('click', () => (fold(), el.scrollBy({ left: Number(b.dataset.marqueeStep) * el.clientWidth * 0.5, behavior: 'smooth' }))),
    );
  });
</script>
