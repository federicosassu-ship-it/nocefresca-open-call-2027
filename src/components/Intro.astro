---
// Landing intro — the first "screen" of the page.
// On load the Nocefresca wordmark assembles letter by letter over drawn topographic lines.
// Scrolling then drives the transition (scrubbed, reversible): the paper section scrolls away naturally
// while the wordmark flies into the header logo. Skipped for prefers-reduced-motion and without JS.
import wordmarkSvg from '../assets/img/brand/nocefresca-wordmark.svg?raw';
import contours from '../generated/contours.json';
import wordmarkSmooth from '../generated/wordmark-smooth.json';
import { status } from '../content/opencall';

const d = wordmarkSmooth.d; // smooth curves rebuilt from the official SVG by scripts/build-wordmark.mjs
const fill = wordmarkSvg.match(/fill="(#[0-9a-fA-F]{3,6})"/)?.[1] ?? '#572400';
const subpaths = d.split('M').map((s) => s.trim()).filter(Boolean).map((s) => `M ${s}`);
const starts = [17, 55, 95, 134, 172, 198, 220, 259, 294, 333]; // left edge of each letter: n o c e f r e s c a
const letters: string[] = starts.map(() => '');
for (const sp of subpaths) {
  const nums = [...sp.matchAll(/-?\d+(?:\.\d+)?/g)].map((m) => Number(m[0]));
  const minX = Math.min(...nums.filter((_, k) => k % 2 === 0));
  let i = 0;
  starts.forEach((x, k) => { if (x <= minX + 1.5) i = k; });
  letters[i] += sp;
}
---
<section class="intro" id="intro" data-intro aria-label="Nocefresca">
  <svg class="intro__lines" viewBox={contours.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d={contours.b} pathLength="1" />
  </svg>
  <div class="intro__fx" data-intro-fx aria-hidden="true">
    <p class="intro__tag" data-intro-tag><b>Artist residency in Milis, Sardinia</b> <span>·</span> <b>Open Call {status.year}</b></p>
    <a class="intro__cue" href="#top" data-intro-cue tabindex="-1"><span>Scroll</span><i></i></a>
  </div>
</section>

<!-- the wordmark flies on its own fixed layer, above the page -->
<div class="intro-mark" data-intro-layer aria-hidden="true">
  <svg class="intro-mark__svg" data-intro-mark viewBox="0 0 386 68" shape-rendering="geometricPrecision">
    <defs><clipPath id="intro-clip"><rect x="0" y="0" width="386" height="64" /></clipPath></defs>
    <g clip-path="url(#intro-clip)" fill={fill} fill-rule="evenodd">
      {letters.map((p) => <path class="intro__letter" d={p} />)}
    </g>
  </svg>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.documentElement;
  const section = document.querySelector<HTMLElement>('[data-intro]');
  const layer = document.querySelector<HTMLElement>('[data-intro-layer]');
  const headerLogo = document.querySelector<HTMLElement>('.site-header .brand img');
  const header = document.querySelector<HTMLElement>('.site-header');

  if (section && layer && headerLogo && header && root.classList.contains('has-intro')) {
    gsap.registerPlugin(ScrollTrigger);
    const mark = layer.querySelector<SVGSVGElement>('[data-intro-mark]')!;
    const letters = layer.querySelectorAll('.intro__letter');
    const lines = section.querySelector<SVGPathElement>('.intro__lines path')!;
    const fx = section.querySelector<HTMLElement>('[data-intro-fx]')!;
    const tag = section.querySelector('[data-intro-tag]')!;
    const cue = section.querySelector<HTMLElement>('[data-intro-cue]')!;
    const heroImg = document.querySelector<HTMLElement>('#top .hero__media img');

    // ---- 1 · arrival (time-based, once the display font is ready) ----
    const arrive = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } })
      .fromTo(lines, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 2.8, ease: 'power2.inOut' }, 0)
      .fromTo(letters, { y: 72 }, { y: 0, duration: 1.35, stagger: 0.06 }, 0.2)
      .fromTo(tag, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 1.1 }, 0.95)
      .fromTo(cue, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.8 }, 1.6);
    Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 600))]).then(() => requestAnimationFrame(() => arrive.play()));
    // scrolling before the letters have landed: finish them quickly instead of fighting the scroll
    window.addEventListener('scroll', () => { if (arrive.progress() < 1) arrive.timeScale(3); }, { once: true, passive: true });

    // ---- 2 · scroll-driven flight into the header logo ----
    // where the wordmark sits inside the header PNG (fractions of its box)
    const WORD_X = 0.002, WORD_Y = 0.008, WORD_W = 0.994;
    let fly = { x: 0, y: 0, s: 1 };
    const measure = () => {
      gsap.set(mark, { clearProps: 'transform' });
      const m = mark.getBoundingClientRect(); // fixed layer: viewport coords, independent of scroll
      const lg = headerLogo.getBoundingClientRect();
      const hd = header.getBoundingClientRect();
      // the header reaches the top of the viewport exactly when the intro has scrolled away
      const logoTop = lg.top - hd.top;
      const L = m.left + m.width * (17 / 386), T = m.top + m.height * (11 / 68), W = m.width * (350 / 386);
      const s = (lg.width * WORD_W) / W;
      fly = { s, x: lg.left + lg.width * WORD_X - m.left - (L - m.left) * s, y: logoTop + lg.height * WORD_Y - m.top - (T - m.top) * s };
    };
    measure();

    const flight = { p: 0 };
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: 'bottom top',
        scrub: 0.6,
        invalidateOnRefresh: true,
        onRefreshInit: measure,
        onUpdate: (st) => { layer.style.visibility = st.progress >= 0.999 ? 'hidden' : ''; },
      },
    });
    tl.to(fx, { autoAlpha: 0, y: -24, duration: 0.25, ease: 'power1.in' }, 0)
      // the wordmark homes in on the header *as it rises*, so both land together
      .to(flight, { p: 1, duration: 1, onUpdate: () => {
        const p = flight.p, e = gsap.parseEase('power2.inOut')(p);
        const H = section.offsetHeight;
        const targetY = fly.y + H * (1 - p); // header logo's live position during the scroll
        gsap.set(mark, { transformOrigin: '0 0', x: fly.x * e, y: targetY * e, scale: 1 + (fly.s - 1) * e });
      } }, 0)
      .fromTo(headerLogo, { opacity: 0 }, { opacity: 1, duration: 0.08 }, 0.9)
      .to(mark, { opacity: 0, duration: 0.08 }, 0.93);
    if (heroImg) tl.fromTo(heroImg, { scale: 1.08 }, { scale: 1, duration: 1, ease: 'power1.out' }, 0);

    cue.addEventListener('click', (e) => { e.preventDefault(); window.scrollTo({ top: section.offsetHeight, behavior: 'smooth' }); });
    // Always open on the intro (no restored mid-page position); deep links (#section) land on their section
    // once the scroll-driven layout has been measured.
    window.addEventListener('load', () => {
      ScrollTrigger.refresh();
      const target = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (target) target.scrollIntoView();
      else window.scrollTo(0, 0);
    });
  }
</script>

<style>
  .intro, .intro-mark { display: none; }
  :global(.has-intro) .intro { position: relative; display: grid; place-items: center; height: 100svh; min-height: 32rem; background: var(--c-paper); overflow: hidden; }
  :global(.has-intro) .intro-mark { display: grid; place-items: center; position: fixed; inset: 0; z-index: 60; pointer-events: none; }
  .intro__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .intro__lines path { fill: none; stroke: var(--c-burgundy); stroke-opacity: 0.16; stroke-width: 1.1; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .intro-mark__svg { width: min(78vw, 46rem); height: auto; overflow: visible; will-change: transform, opacity; backface-visibility: hidden; }
  .intro__letter { transform: translateY(72px); } /* initial state in CSS: nothing flashes before the script runs */
  .intro__fx { position: absolute; inset: 0; }
  .intro__tag { position: absolute; top: calc(50% + min(78vw, 46rem) * 0.09 + clamp(1.25rem, 2.5vw, 2.25rem)); left: 0; right: 0; padding-inline: var(--gutter); font-family: var(--f-display); font-weight: 500; font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.125rem); color: var(--c-burgundy); letter-spacing: 0.01em; text-align: center; visibility: hidden; }
  .intro__tag b { font-weight: inherit; white-space: nowrap; }
  .intro__tag span { color: var(--c-terracotta); margin: 0 0.35em; }
  .intro__cue { position: absolute; left: 50%; bottom: max(1.5rem, env(safe-area-inset-bottom)); transform: translateX(-50%); display: grid; justify-items: center; gap: 0.6rem; font-family: var(--f-display); font-size: 0.8125rem; color: var(--c-muted); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; visibility: hidden; }
  .intro__cue i { display: block; width: 1px; height: 2.75rem; background: linear-gradient(var(--c-burgundy), transparent); transform-origin: top; animation: cue 1.8s cubic-bezier(.6,0,.2,1) infinite; }
  @keyframes cue { 0% { transform: scaleY(0); opacity: 1; } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }
  /* header logo is revealed by the flight; hero photo zoom is driven by the scroll instead of its load animation */
  :global(.has-intro .site-header .brand img) { opacity: 0; }
  :global(.has-intro #top .hero__media img) { animation: none; }
</style>
