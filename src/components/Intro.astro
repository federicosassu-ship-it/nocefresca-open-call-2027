---
// Landing intro: the Nocefresca wordmark (official SVG) assembles letter by letter over drawn topographic lines,
// then, at the first scroll gesture (or after ~5 s), flies into the header while a paper curtain lifts to reveal the hero.
// Shown once per session; skipped for prefers-reduced-motion, deep links (#hash) and pages loaded already scrolled.
import wordmarkSvg from '../assets/img/brand/nocefresca-wordmark.svg?raw';
import contours from '../generated/contours.json';
import wordmarkSmooth from '../generated/wordmark-smooth.json';
import { status } from '../content/opencall';

const d = wordmarkSmooth.d; // smooth curves rebuilt from the official SVG by scripts/build-wordmark.mjs
const fill = wordmarkSvg.match(/fill="(#[0-9a-fA-F]{3,6})"/)?.[1] ?? '#572400';
const subpaths = d.split('M').map((s) => s.trim()).filter(Boolean).map((s) => `M ${s}`);
const starts = [17, 55, 95, 134, 172, 198, 220, 259, 294, 333]; // left edge of each letter: n o c e f r e s c a
const letters: string[] = starts.map(() => '');
for (const sp of subpaths) {
  const nums = [...sp.matchAll(/-?\d+(?:\.\d+)?/g)].map((m) => Number(m[0]));
  const minX = Math.min(...nums.filter((_, k) => k % 2 === 0));
  let i = 0;
  starts.forEach((x, k) => { if (x <= minX + 1.5) i = k; });
  letters[i] += sp;
}
---
<div class="intro" data-intro aria-hidden="true">
  <div class="intro__curtain" data-intro-curtain>
    <svg class="intro__lines" viewBox={contours.viewBox} preserveAspectRatio="xMidYMid slice">
      <path d={contours.b} pathLength="1" />
    </svg>
  </div>
  <div class="intro__center">
    <svg class="intro__mark" data-intro-mark viewBox="0 0 386 68" role="img" shape-rendering="geometricPrecision">
      <defs>
        <clipPath id="intro-clip"><rect x="0" y="0" width="386" height="64" /></clipPath>
      </defs>
      <g clip-path="url(#intro-clip)" fill={fill} fill-rule="evenodd">
        {letters.map((p) => <path class="intro__letter" d={p} />)}
      </g>
    </svg>
    <p class="intro__tag" data-intro-tag><b>Artist residency in Milis, Sardinia</b> <span>·</span> <b>Open Call {status.year}</b></p>
  </div>
  <button class="intro__cue" type="button" data-intro-cue tabindex="-1" aria-label="Enter">
    <span>Scroll</span><i aria-hidden="true"></i>
  </button>
</div>

<script>
  import { gsap } from 'gsap';

  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const headerLogo = document.querySelector<HTMLElement>('.site-header .brand img');

  const cleanup = () => {
    root.classList.remove('has-intro', 'intro-ready');
    // inline styles are cleared only after the class is gone, so nothing falls back to the hidden intro state
    document.querySelectorAll<HTMLElement>('#top .hero__top, #top .hero__bottom').forEach((el) => { el.style.removeProperty('opacity'); el.style.removeProperty('visibility'); el.style.removeProperty('transform'); });
    intro?.remove();
    if (headerLogo) headerLogo.style.opacity = '';
  };

  if (!intro || !headerLogo || !root.classList.contains('has-intro')) {
    cleanup();
  } else {
    try { sessionStorage.setItem('nf-intro-seen', '1'); } catch { /* storage blocked */ }
    const mark = intro.querySelector<SVGSVGElement>('[data-intro-mark]')!;
    const letters = intro.querySelectorAll('.intro__letter');
    const curtain = intro.querySelector<HTMLElement>('[data-intro-curtain]')!;
    const lines = intro.querySelector<SVGPathElement>('.intro__lines path')!;
    const tag = intro.querySelector('[data-intro-tag]')!;
    const cue = intro.querySelector<HTMLElement>('[data-intro-cue]')!;
    const heroImg = document.querySelector<HTMLElement>('#top .hero__media img');
    const heroText = document.querySelectorAll<HTMLElement>('#top .hero__top, #top .hero__bottom');
    headerLogo.style.opacity = '0';
    root.classList.add('intro-ready');

    // ---- 1 · arrival (starts once the display font is ready, so the tagline never reflows mid-animation) ----
    const arrive = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } })
      .fromTo(lines, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 2.8, ease: 'power2.inOut' }, 0)
      .fromTo(letters, { y: 72 }, { y: 0, duration: 1.35, stagger: 0.06 }, 0.2)
      .fromTo(tag, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 1.1 }, 0.95)
      .fromTo(cue, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.8 }, 1.6);
    Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 600))]).then(() => requestAnimationFrame(() => arrive.play()));

    // ---- 2 · exit: the wordmark flies into the header logo while the paper curtain slides away ----
    let leaving = false;
    const leave = () => {
      if (leaving) return;
      leaving = true;
      clearTimeout(auto);
      // let the letters finish landing first (sped up), then leave
      if (arrive.progress() < 1) { arrive.play(); arrive.timeScale(2.4); arrive.eventCallback('onComplete', go); } else go();
    };
    const go = () => {
      // FLIP into the header: letters span x 17–367 / y 11–61 of the 386×68 viewBox;
      // the header PNG's wordmark spans its full width from its top edge.
      const m = mark.getBoundingClientRect();
      const h = headerLogo.getBoundingClientRect();
      const L = m.left + m.width * (17 / 386), T = m.top + m.height * (11 / 68), W = m.width * (350 / 386);
      const s = (h.width * WORD_W) / W;
      const x = h.left + h.width * WORD_X - m.left - (L - m.left) * s;
      const y = h.top + h.height * WORD_Y - m.top - (T - m.top) * s;
      const tl = gsap.timeline({ onComplete: cleanup });
      tl.to([cue, tag], { autoAlpha: 0, y: -12, duration: 0.55, ease: 'power2.in' }, 0)
        .to(mark, { transformOrigin: '0 0', x, y, scale: s, duration: 1.8, ease: 'power3.inOut' }, 0.1)
        .to(curtain, { yPercent: -100, duration: 1.6, ease: 'power3.inOut' }, 0.35)
        // the page wakes up as it is revealed
        .fromTo(heroText, { y: 32, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 1.3, ease: 'power3.out', stagger: 0.12 }, 0.85);
      if (heroImg) tl.fromTo(heroImg, { scale: 1.08 }, { scale: 1, duration: 2.2, ease: 'power2.out', clearProps: 'transform' }, 0.45);
      // seamless hand-off: cross-fade exactly as the wordmark lands on the header logo
      tl.to(headerLogo, { opacity: 1, duration: 0.35, ease: 'none' }, 1.72)
        .to(mark, { opacity: 0, duration: 0.35, ease: 'none' }, 1.78);
    };
    // where the wordmark sits inside the header PNG (fractions of its box) — calibrated in QA
    const WORD_X = 0.002, WORD_Y = 0.008, WORD_W = 0.994;

    // a deliberate scroll gesture starts the exit; the page never scrolls underneath
    let acc = 0, accT = 0, done = false;
    const onWheel = (e: WheelEvent) => {
      const now = performance.now();
      const gap = now - accT;
      accT = now;
      if (done) {
        // swallow the tail of a trackpad's momentum after the intro is gone, so the page doesn't lurch
        if (gap < 180) e.preventDefault(); else window.removeEventListener('wheel', onWheel);
        return;
      }
      e.preventDefault();
      if (gap > 400) acc = 0;
      acc += Math.max(0, e.deltaY);
      if (acc > 160) leave();
    };
    const onKey = (e: KeyboardEvent) => { if ([' ', 'ArrowDown', 'PageDown', 'End', 'Enter', 'Escape', 'Tab'].includes(e.key)) { if (e.key !== 'Tab') e.preventDefault(); leave(); } };
    let y0 = 0;
    const onTouchStart = (e: TouchEvent) => { y0 = e.touches[0].clientY; };
    const onTouchMove = (e: TouchEvent) => { e.preventDefault(); if (y0 - e.touches[0].clientY > 48) leave(); };
    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('keydown', onKey);
    intro.addEventListener('touchstart', onTouchStart, { passive: true });
    intro.addEventListener('touchmove', onTouchMove, { passive: false });
    intro.addEventListener('click', leave);
    const auto = window.setTimeout(leave, 6500); // never hold ad traffic back
    new MutationObserver((_, obs) => {
      if (document.contains(intro)) return;
      done = true;
      window.removeEventListener('keydown', onKey);
      obs.disconnect();
    }).observe(document.body, { childList: true });
  }
</script>

<style>
  .intro { display: none; }
  :global(.has-intro) .intro { display: grid; place-items: center; position: fixed; inset: 0; z-index: 70; pointer-events: auto; }
  /* the paper slides away on the compositor (transform), the wordmark flies on its own layer above it */
  .intro__curtain { position: absolute; inset: 0; background: var(--c-paper); overflow: hidden; will-change: transform; }
  .intro__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .intro__lines path { fill: none; stroke: var(--c-burgundy); stroke-opacity: 0.16; stroke-width: 1.1; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .intro__center { position: relative; display: grid; justify-items: center; gap: clamp(1rem, 2vw, 1.75rem); width: min(78vw, 46rem); }
  .intro__mark { width: 100%; height: auto; overflow: visible; will-change: transform, opacity; backface-visibility: hidden; }
  /* initial state in CSS so nothing flashes before the script runs */
  .intro__letter { transform: translateY(72px); }
  .intro__tag { font-family: var(--f-display); font-weight: 500; font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.125rem); color: var(--c-burgundy); letter-spacing: 0.01em; text-align: center; visibility: hidden; }
  .intro__tag b { font-weight: inherit; white-space: nowrap; }
  .intro__tag span { color: var(--c-terracotta); margin: 0 0.35em; }
  .intro__cue { position: absolute; left: 50%; bottom: max(1.5rem, env(safe-area-inset-bottom)); transform: translateX(-50%); display: grid; justify-items: center; gap: 0.6rem; font-family: var(--f-display); font-size: 0.8125rem; color: var(--c-muted); letter-spacing: 0.08em; text-transform: uppercase; visibility: hidden; }
  .intro__cue i { display: block; width: 1px; height: 2.75rem; background: linear-gradient(var(--c-burgundy), transparent); transform-origin: top; animation: cue 1.8s cubic-bezier(.6,0,.2,1) infinite; }
  @keyframes cue { 0% { transform: scaleY(0); opacity: 1; } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }
  /* lock scrolling without the layout jump of a disappearing scrollbar */
  :global(html.has-intro) { overflow: hidden; scrollbar-gutter: stable; }
  :global(.has-intro .sticky-apply) { visibility: hidden; }
  /* hero's own load animation would already be over behind the intro: the intro replays it on reveal */
  :global(.has-intro #top .hero__media img) { animation: none; }
  :global(.has-intro #top .hero__top), :global(.has-intro #top .hero__bottom) { opacity: 0; }
</style>
