---
import { status, statusCopy } from '../content/opencall';
interface Props { variant?: 'chip' | 'block' | 'inline'; tone?: 'light' | 'ochre' | 'dark' }
const { variant = 'chip', tone = 'light' } = Astro.props;
const c = statusCopy[status.state];
const live = status.state === 'open' || status.state === 'rolling';
---
{variant === 'chip' && (
  <p class={`status status--chip tone-${tone}`} data-status={status.state}>
    <span class={`dot ${live ? 'dot--pulse' : ''}`} aria-hidden="true"></span>
    <span><strong>{c.badge}</strong><span class="status__sep" aria-hidden="true"> · </span><span class="status__line">{c.line}</span></span>
  </p>
)}
{variant === 'inline' && (
  <span class={`status status--inline tone-${tone}`} data-status={status.state}>
    <span class={`dot ${live ? 'dot--pulse' : ''}`} aria-hidden="true"></span><strong>{c.badge}</strong>
  </span>
)}
{variant === 'block' && (
  <div class={`status status--block tone-${tone}`} data-status={status.state}>
    <p class="status__head"><span class={`dot ${live ? 'dot--pulse' : ''}`} aria-hidden="true"></span><strong>{c.badge}</strong></p>
    <p class="status__detail">{c.detail}</p>
    {status.note && <p class="status__note">{status.note}</p>}
  </div>
)}

<style>
  .status { font-family: var(--f-display); font-weight: 400; line-height: 1.35; }
  .status strong { font-weight: 600; }
  .status .dot { color: var(--c-olive); }
  [data-status='closed'] .dot { color: var(--c-burgundy); }
  [data-status='upcoming'] .dot { color: var(--c-terracotta); }
  .status--chip { display: inline-flex; align-items: flex-start; gap: 0.6rem; font-size: 0.9375rem; padding: 0.55rem 0.9rem 0.55rem 0.8rem; border-radius: var(--radius); background: rgb(246 241 231 / 0.92); color: var(--c-ink); box-shadow: inset 0 0 0 1px var(--c-line); max-width: 100%; }
  .status--chip .dot { margin-top: 0.42em; }
  .status--chip.tone-ochre { background: var(--c-ochre); box-shadow: none; }
  .status--inline { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; }
  .tone-dark .dot { color: var(--c-ochre); }
  .status--block { padding: 1.25rem 1.4rem; background: var(--c-paper); border-left: 3px solid var(--c-olive); border-radius: var(--radius); }
  [data-status='closed'].status--block { border-left-color: var(--c-burgundy); }
  .status__head { display: flex; align-items: center; gap: 0.6rem; font-size: 1.0625rem; color: var(--c-ink); }
  .status__detail { font-family: var(--f-text); font-size: var(--fs-small); margin-top: 0.4rem; max-width: 48ch; }
  .status__note { font-size: 0.875rem; margin-top: 0.5rem; color: var(--c-muted); }
  @media (max-width: 30rem) { .status--chip .status__sep, .status--chip .status__line { display: none; } }
</style>
