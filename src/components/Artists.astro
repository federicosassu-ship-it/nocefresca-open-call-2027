---
import { Picture, Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Rail from './Rail.astro';
import ApplyButton from './ApplyButton.astro';
import Arrow from './Arrow.astro';
import { img } from '../lib/images';
import { testimonials, letter, residentVideos, stats, links } from '../content/opencall';
import contoursLight from '../generated/contours-light.svg?url';

const network = [
  { src: 'brand/net-alliance.png', alt: 'Alliance of Artists Communities', href: 'https://artistcommunities.org/', w: 150 },
  { src: 'brand/net-resartis.png', alt: 'Res Artis', href: 'https://resartis.org/', w: 140 },
  { text: 'TransArtists', alt: 'TransArtists', href: 'https://www.transartists.org/en/air/nocefresca' }, // TODO: swap for the TransArtists logo when available
];
---
<section class="section artists" id="artists" aria-labelledby="artists-title">
  <div class="container">
    <SectionHead nr="06" kicker="Artists" id="artists-title" split
      title="In the words of past residents."
      lead="Writers, painters, composers, filmmakers, designers — from 30+ countries. Here is what they say, in their own words." />

    <figure class="letter" data-reveal>
      <div class="letter__media media">
        <Picture src={img('life/writer-wall.jpg')} formats={['webp']} widths={[480, 800, 1100]} sizes="(min-width: 60rem) 40vw, 92vw" quality={70} alt="A resident in overalls stands in her studio in front of a wall covered with pinned notes." loading="lazy" />
      </div>
      <div class="letter__body">
        <span class="contours" style={`background-image:url(${contoursLight})`} aria-hidden="true"></span>
        <p class="letter__kicker">Letter to inquiring artists</p>
        <blockquote>
          <p class="quote letter__lead">{letter.quotes.lead}</p>
          <p class="quote letter__more">{letter.quotes.middle}</p>
          <p class="quote letter__more">{letter.quotes.group}</p>
        </blockquote>
        <figcaption>
          <span class="letter__who"><strong>{letter.author}</strong> {letter.role}</span>
          <a class="text-link" href={links.letterMakenzie} data-track="outbound_click" data-location="letter_full">Read the full letter<Arrow size={16} /></a>
        </figcaption>
      </div>
    </figure>

    <Rail label="Testimonials" id="rail-voices" track="voices" class="voices">
      {testimonials.map((t) => (
        <figure class="voice">
          <div class="voice__head">
            <Image src={img(`people/${t.portrait}`)} alt="" width={64} height={64} densities={[1, 2]} format="webp" class="voice__face" loading="lazy" />
            <figcaption><strong>{t.name}</strong><span>{t.role} · {t.country}</span></figcaption>
          </div>
          <blockquote><p class="voice__quote">“{t.quote}”</p></blockquote>
          <a class="voice__link small link" href={t.url} data-track="outbound_click" data-location={`voice_${t.id}`} rel="noopener">See {t.name.split(' ')[0]}’s work<span class="visually-hidden"> (external site)</span></a>
        </figure>
      ))}
    </Rail>

    <ul class="stats" role="list" data-reveal>
      {stats.map((s) => <li><span class="stats__v num">{s.value}</span><span class="stats__l">{s.label}</span></li>)}
    </ul>

    <div class="residents">
      <div class="residents__head" data-reveal>
        <h3>Past residents, in their own videos</h3>
        <a class="text-link" href={links.artists} data-track="outbound_click" data-location="all_artists">See all past residents<Arrow size={16} /></a>
      </div>
      <Rail label="Videos of past residents" id="rail-videos" track="videos" class="videos">
        {residentVideos.map((v) => (
          <figure class="vid">
            <button type="button" class="vid__poster media" data-reel={v.reel} data-reel-title={`${v.name} — ${v.role}, ${v.from}`} data-track="video_open" data-location={v.reel} aria-label={`Play the video of ${v.name}, ${v.role.toLowerCase()} from ${v.from}`}>
              <Picture src={img(`videos/${v.img}`)} formats={['webp']} widths={[280, 480]} sizes="15rem" quality={68} alt="" loading="lazy" />
              <span class="vid__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg></span>
            </button>
            <figcaption><strong>{v.name}</strong><span>{v.role}</span><span class="muted">{v.from}</span></figcaption>
          </figure>
        ))}
      </Rail>
      <p class="caption">Videos play from Instagram.</p>
    </div>

    <dialog class="reel" data-reel-dialog aria-label="Resident video">
      <div class="reel__box">
        <div class="reel__bar">
          <p class="reel__title" data-reel-name></p>
          <button type="button" class="reel__close" data-reel-close aria-label="Close video">✕</button>
        </div>
        <div class="reel__frame" data-reel-frame></div>
        <a class="reel__link small" data-reel-link href="#" target="_blank" rel="noopener">Open on Instagram</a>
      </div>
    </dialog>

    <div class="trust" data-reveal>
      <p class="label">Network</p>
      <ul class="trust__logos" role="list">
        {network.map((n) => (
          <li><a href={n.href} data-track="outbound_click" data-location="network" rel="noopener">{n.src ? <Image src={img(n.src)} alt={n.alt} width={n.w} densities={[1, 2]} format="webp" loading="lazy" /> : <span class="trust__word">{n.text}</span>}</a></li>
        ))}
      </ul>
      <div class="trust__cta"><ApplyButton location="artists" label="Apply for 2027" /></div>
    </div>
  </div>
</section>

<style>
  .letter { display: grid; margin: 0 0 clamp(2.5rem, 2rem + 2vw, 4rem); border-radius: var(--radius); overflow: hidden; background: var(--c-ochre); }
  .letter__media { aspect-ratio: 4 / 3; border-radius: 0; }
  .letter__body { position: relative; padding: clamp(1.75rem, 1.2rem + 2.5vw, 3.5rem); display: flex; flex-direction: column; gap: 1.25rem; }
  .letter__body .contours { opacity: 0.6; }
  .letter__body > * { position: relative; }
  .letter__kicker { font-family: var(--f-display); font-size: 0.875rem; font-weight: 500; color: var(--c-burgundy); }
  .letter blockquote { margin: 0; display: grid; gap: 1rem; }
  .letter__lead { font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3.25rem); line-height: 1.08; color: var(--c-burgundy); }
  .letter__more { font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); color: var(--c-ink); line-height: 1.4; }
  .letter figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--c-line-strong); }
  .letter__who { font-family: var(--f-display); font-size: 0.9375rem; display: grid; color: var(--c-ink); }
  .letter__who strong { font-weight: 600; color: var(--c-burgundy); }

  :global(.voices .rail) { grid-auto-columns: min(84vw, 24rem); }
  @media (min-width: 60rem) { :global(.voices .rail) { grid-auto-columns: minmax(0, 1fr); } }
  .voice { margin: 0; display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem; background: var(--c-white); border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--c-line); height: 100%; }
  .voice__head { display: flex; align-items: center; gap: 0.9rem; }
  .voice__face { width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; flex: none; }
  .voice figcaption { display: grid; font-family: var(--f-display); line-height: 1.25; }
  .voice figcaption strong { font-weight: 600; color: var(--c-burgundy); font-size: 1.0625rem; }
  .voice figcaption span { font-size: 0.875rem; color: var(--c-muted); }
  .voice blockquote { margin: 0; flex: 1; }
  .voice__quote { font-size: 1.0625rem; line-height: 1.5; }
  .voice__link { font-family: var(--f-display); }

  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0; padding: 1.75rem 0; border-block: 1px solid var(--c-line-strong); }
  .stats li { display: grid; gap: 0.25rem; }
  .stats__v { font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem); font-weight: 500; line-height: 1; letter-spacing: -0.035em; color: var(--c-burgundy); }
  .stats__l { font-family: var(--f-display); font-size: 0.9375rem; color: var(--c-ink); }

  .residents__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; margin-bottom: 1.25rem; }
  :global(.videos .rail) { grid-auto-columns: min(62vw, 15rem); }
  .vid { margin: 0; }
  .vid__poster { position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; padding: 0; cursor: pointer; }
  .vid__poster :global(img) { transition: transform 0.6s var(--ease); }
  .vid__poster:hover :global(img) { transform: scale(1.04); }
  .vid__play { position: absolute; left: 0.75rem; bottom: 0.75rem; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--c-ochre); color: var(--c-ink); box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.5); transition: transform 0.25s var(--ease); }
  .vid__poster:hover .vid__play { transform: scale(1.08); }
  .vid figcaption { display: grid; gap: 0.1rem; margin-top: 0.6rem; font-family: var(--f-display); font-size: 0.875rem; line-height: 1.3; color: var(--c-ink); }
  .vid figcaption strong { font-weight: 600; color: var(--c-burgundy); font-size: 0.9375rem; }
  .residents .caption { margin-top: 0.5rem; }
  .reel { width: min(94vw, 26rem); max-height: 94vh; padding: 0; border: 0; border-radius: var(--radius); background: var(--c-paper); }
  .reel::backdrop { background: rgb(46 18 14 / 0.6); }
  .reel__box { display: grid; gap: 0.5rem; padding: 0.75rem; }
  .reel__bar { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .reel__title { font-family: var(--f-display); font-weight: 500; font-size: 0.9375rem; color: var(--c-burgundy); }
  .reel__close { flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; color: var(--c-burgundy); box-shadow: inset 0 0 0 1.5px var(--c-line-strong); }
  .reel__frame { position: relative; height: min(78vh, 42rem); background: var(--c-sand); border-radius: var(--radius); overflow: hidden; }
  .reel__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .reel__link { justify-self: start; font-family: var(--f-display); color: var(--c-burgundy); min-height: 2.25rem; display: inline-flex; align-items: center; }

  .trust { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.5rem; margin-top: clamp(2rem, 1.5rem + 2vw, 3rem); padding-top: 1.5rem; border-top: 1px solid var(--c-line); }
  .trust__logos { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.25rem; }
  .trust__word { display: inline-flex; align-items: center; height: 2.5rem; font-family: var(--f-display); font-weight: 600; font-size: 1.375rem; letter-spacing: -0.02em; color: var(--c-brown); }
  .trust__cta { margin-left: auto; }
  .trust__logos img { height: auto; max-height: 2.75rem; width: auto; mix-blend-mode: multiply; }
  .trust__logos a { display: block; padding: 0.25rem 0; }
  @media (min-width: 40rem) { .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 60rem) {
    .letter { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .letter__media { aspect-ratio: auto; min-height: 100%; }
  }
</style>

<script>
  // Click-to-load: Instagram is contacted only when someone chooses to watch a video.
  const dlg = document.querySelector<HTMLDialogElement>('[data-reel-dialog]');
  if (dlg) {
    const frame = dlg.querySelector<HTMLElement>('[data-reel-frame]')!;
    const name = dlg.querySelector<HTMLElement>('[data-reel-name]')!;
    const link = dlg.querySelector<HTMLAnchorElement>('[data-reel-link]')!;
    document.querySelectorAll<HTMLButtonElement>('[data-reel]').forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.reel!;
        name.textContent = b.dataset.reelTitle || '';
        link.href = `https://www.instagram.com/reel/${id}/`;
        frame.innerHTML = `<iframe src="https://www.instagram.com/reel/${id}/embed/" title="${(b.dataset.reelTitle || 'Resident video').replace(/"/g, '')}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
        dlg.showModal();
      }),
    );
    const close = () => dlg.close();
    dlg.addEventListener('close', () => { frame.innerHTML = ''; });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.querySelector('[data-reel-close]')?.addEventListener('click', close);
  }
</script>
