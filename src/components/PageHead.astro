---
import { Picture } from 'astro:assets';
import ApplyButton from './ApplyButton.astro';
import StatusBadge from './StatusBadge.astro';
import Arrow from './Arrow.astro';
import { img } from '../lib/images';
import { anchor } from '../lib/paths';
import { status } from '../content/opencall';
import contoursInk from '../generated/contours-ink.svg?url';

interface Props { kicker: string; title: string; lead: string; photo?: string; alt?: string; jump?: { href: string; label: string }[]; facts?: string[] }
const { kicker, title, lead, photo, alt = '', jump = [], facts = [] } = Astro.props;
---
<section class="phead" id="top" aria-labelledby="page-title">
  <span class="contours phead__contours" style={`background-image:url(${contoursInk})`} aria-hidden="true"></span>
  <div class="container phead__inner">
    <div class="phead__text">
      <a class="phead__back text-link" href={anchor('glance')} data-track="nav_click" data-location="back_overview"><Arrow dir="left" size={16} />Open Call {status.year} overview</a>
      <p class="nr"><b>Open Call {status.year}</b><span>{kicker}</span></p>
      <h1 id="page-title">{title}</h1>
      <p class="lead">{lead}</p>
      {facts.length > 0 && <ul class="phead__facts" role="list">{facts.map((f) => <li>{f}</li>)}</ul>}
      <div class="phead__ctas">
        <ApplyButton location={`page_${kicker.toLowerCase().replace(/[^a-z]+/g, '_')}_head`} />
        <StatusBadge variant="inline" />
      </div>
      {jump.length > 0 && (
        <nav class="phead__jump" aria-label="On this page">
          {jump.map((j) => <a href={j.href} data-track="nav_click" data-location={`jump_${j.label}`}>{j.label}</a>)}
        </nav>
      )}
    </div>
    {photo && (
      <div class="phead__media media">
        <Picture src={img(photo)} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 42vw, 100vw" quality={60} alt={alt} loading="eager" fetchpriority="high" />
      </div>
    )}
  </div>
</section>

<style>
  .phead { position: relative; overflow: hidden; padding: calc(var(--header-h) + 1rem) 0 clamp(2.5rem, 2rem + 3vw, 4.5rem); border-bottom: 1px solid var(--c-line); }
  .phead__contours { opacity: 0.8; mask-image: linear-gradient(to right, black, transparent 80%); }
  .phead__inner { position: relative; display: grid; gap: 2rem; }
  .phead__text { display: grid; gap: 1rem; justify-items: start; align-content: center; }
  .phead__back { font-size: 0.9375rem; }
  .phead h1 { font-size: clamp(2.5rem, 1.6rem + 4vw, 5rem); line-height: 0.98; letter-spacing: -0.03em; max-width: 14ch; }
  .phead__facts { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .phead__facts li { font-family: var(--f-display); font-size: 0.875rem; font-weight: 500; padding: 0.35rem 0.75rem; border-radius: 999px; background: var(--c-ochre); color: var(--c-ink); }
  .phead__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 0.5rem; }
  .phead__jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .phead__jump a { font-family: var(--f-display); font-size: 0.9375rem; font-weight: 500; color: var(--c-burgundy); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; padding: 0 1rem; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--c-line-strong); }
  .phead__jump a:hover { box-shadow: inset 0 0 0 1.5px var(--c-burgundy); }
  .phead__media { aspect-ratio: 4 / 3; }
  @media (min-width: 60rem) {
    .phead { padding-top: clamp(3rem, 2rem + 3vw, 5rem); }
    .phead__inner { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; gap: clamp(2rem, 4vw, 5rem); }
    .phead__media { aspect-ratio: 5 / 4; }
  }
</style>
