---
import SectionHead from './SectionHead.astro';
import StatusBadge from './StatusBadge.astro';
import ApplyButton from './ApplyButton.astro';
import Arrow from './Arrow.astro';
import Rail from './Rail.astro';
import { periods, links } from '../content/opencall';
import { shortDate, nights } from '../lib/format';
import contoursLight from '../generated/contours-light.svg?url';

const availabilityLabel = { available: 'Places available', few: 'Few places left', full: 'Full', unknown: '' } as const;
---
<section class="section section--ochre dates" id="dates" aria-labelledby="dates-title">
  <span class="contours" style={`background-image:url(${contoursLight})`} aria-hidden="true"></span>
  <div class="container dates__inner">
    <SectionHead nr="08" kicker="Dates & availability" id="dates-title" split
      title="Six periods in 2027. Stay one, two or three months."
      lead="Four-week periods from March to June and from September to December." />

    <div class="dates__status" data-reveal><StatusBadge variant="block" /></div>

    <Rail label="Residency periods 2027" id="rail-periods" track="periods" controls="top" class="dates__rail">
      {periods.map((p) => (
        <article class="period">
          <p class="period__label">{p.arrive < '2027-07-01' ? 'Spring' : 'Autumn'} · {p.label}</p>
          <p class="period__dates num"><time datetime={p.arrive}>{shortDate(p.arrive)}</time> <Arrow size={16} /> <time datetime={p.depart}>{shortDate(p.depart)}</time></p>
          <p class="period__meta">{nights(p.arrive, p.depart)} nights · {p.weather}</p>
          <p class="period__hl">{p.highlights}</p>
          {p.availability !== 'unknown' && <p class={`period__avail period__avail--${p.availability}`}>{availabilityLabel[p.availability]}</p>}
        </article>
      ))}
    </Rail>

    <div class="dates__foot" data-reveal>
      <p class="small dates__note">In the form you choose one, two or three months and up to three preferred starting months. Periods may occasionally change, with notice, to design a balanced group.</p>
      <div class="dates__cta">
        <ApplyButton location="dates" />
        <a class="text-link" href={links.whichMonth} data-track="outbound_click" data-location="which_month">Which month should I choose?<Arrow size={16} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .dates { overflow: hidden; padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem); }
  .dates > .contours { opacity: 0.55; }
  .dates__inner { position: relative; }
  .dates .nr span, .dates .section-head .lead { color: var(--c-ink); }
  .dates :global(.section-head) { margin-bottom: 1.5rem; }
  .dates__status { margin-bottom: 1.25rem; max-width: 52rem; }
  :global(.dates__rail .rail) { grid-auto-columns: min(78vw, 19rem); }
  .period { height: 100%; background: var(--c-paper); border-radius: var(--radius); padding: 1.1rem 1.2rem 1.2rem; display: grid; gap: 0.3rem; align-content: start; }
  .period__label { font-family: var(--f-display); font-size: 0.8125rem; font-weight: 500; color: var(--c-terracotta-ink); }
  .period__dates { display: flex; align-items: center; gap: 0.45rem; font-size: 1.5rem; font-weight: 500; color: var(--c-burgundy); letter-spacing: -0.02em; line-height: 1.1; }
  .period__dates :global(.arrow) { color: var(--c-terracotta); }
  .period__meta { font-family: var(--f-display); font-size: 0.8125rem; color: var(--c-muted); }
  .period__hl { font-size: 0.9375rem; line-height: 1.45; margin-top: 0.25rem; }
  .period__avail { justify-self: start; margin-top: 0.5rem; font-family: var(--f-display); font-size: 0.8125rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--c-ochre-soft); color: var(--c-ink); }
  .period__avail--full { background: var(--c-sand); text-decoration: line-through; }
  .dates__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 1.25rem; }
  .dates__note { max-width: 40rem; color: var(--c-ink); }
  .dates__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  @media (min-width: 75rem) { :global(.dates__rail .rail) { grid-auto-columns: calc((100% - 3 * var(--gap)) / 3.4); } }
</style>
