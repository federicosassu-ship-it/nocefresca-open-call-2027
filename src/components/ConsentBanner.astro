---
// Lightweight consent banner (Google Consent Mode v2). Shown only when a tracking ID is configured
// in src/config.ts — or with ?consent-demo in the URL for review. Nothing loads before a choice.
---
<div class="consent" role="dialog" aria-modal="false" aria-labelledby="consent-title" aria-describedby="consent-desc" hidden data-consent>
  <p id="consent-title" class="consent__title">Cookies, briefly</p>
  <p id="consent-desc" class="consent__text small">We’d like to measure visits and the performance of our ads. Nothing is tracked unless you say yes. <a class="link" href="https://www.iubenda.com/privacy-policy/89390951" rel="noopener">Privacy policy</a></p>
  <fieldset class="consent__opts">
    <legend class="visually-hidden">Choose what to allow</legend>
    <label><input type="checkbox" checked disabled /> Necessary</label>
    <label><input type="checkbox" data-consent-analytics /> Analytics</label>
    <label><input type="checkbox" data-consent-marketing /> Ads (Meta, Google)</label>
  </fieldset>
  <div class="consent__actions">
    <button type="button" class="btn btn--ghost" data-consent-reject>Only necessary</button>
    <button type="button" class="btn btn--ghost" data-consent-save>Save choice</button>
    <button type="button" class="btn" data-consent-accept>Accept all</button>
  </div>
</div>

<style>
  .consent { position: fixed; z-index: 60; left: 0.75rem; right: 0.75rem; bottom: 0.75rem; max-width: 30rem; padding: 1.25rem; background: var(--c-paper); border-radius: var(--radius); box-shadow: 0 0 0 1px var(--c-line-strong), 0 18px 40px -20px rgb(62 31 34 / 0.5); display: grid; gap: 0.75rem; }
  .consent[hidden] { display: none; }
  .consent__title { font-family: var(--f-display); font-weight: 600; color: var(--c-burgundy); }
  .consent__opts { border: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-family: var(--f-display); font-size: 0.875rem; }
  .consent__opts label { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.5rem; }
  .consent__opts input { width: 1.1rem; height: 1.1rem; accent-color: var(--c-burgundy); }
  .consent__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .consent__actions .btn { min-height: 2.75rem; padding: 0.6rem 1rem; font-size: 0.9375rem; flex: 1 1 auto; }
  @media (min-width: 60rem) { .consent { left: 1.5rem; bottom: 1.5rem; } }
</style>
