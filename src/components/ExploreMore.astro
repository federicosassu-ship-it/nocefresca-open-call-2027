---
import Arrow from './Arrow.astro';
import ApplyButton from './ApplyButton.astro';
import { anchor, page, type PageKey } from '../lib/paths';
import contoursLight from '../generated/contours-light.svg?url';

const { current } = Astro.props as { current: PageKey };
const all = [
  { key: 'studios', kicker: 'Studios', title: 'Seven private studios and an 80 m² studio garden', href: page('studios'), tone: 'ochre' },
  { key: 'homes', kicker: 'Homes', title: 'Village homes, local hosts and everyday life', href: page('homes'), tone: 'coral' },
  { key: 'datesFees', kicker: 'Dates & fees', title: 'Six periods in 2027, from €1,650 a month', href: page('datesFees'), tone: 'sand' },
  { key: 'overview', kicker: 'Overview', title: 'Back to the Open Call: programme, artists, how to apply', href: anchor('glance'), tone: 'paper' },
].filter((c) => c.key !== current);
---
<section class="section explore" aria-labelledby="explore-title">
  <div class="container">
    <p class="nr"><b>Keep exploring</b><span>Open Call 2027</span></p>
    <h2 id="explore-title" class="explore__title">Where next?</h2>
    <ul class="explore__grid" role="list">
      {all.map((c) => (
        <li class={`ecard ecard--${c.tone}`}>
          {c.tone === 'ochre' && <span class="contours" style={`background-image:url(${contoursLight})`} aria-hidden="true"></span>}
          <p class="ecard__kicker">{c.kicker}</p>
          <p class="ecard__title">{c.title}</p>
          <a class="ecard__link" href={c.href} data-track="explore_click" data-location={c.key}><span class="visually-hidden">{c.kicker}: </span>Open<Arrow size={16} /></a>
        </li>
      ))}
    </ul>
    <div class="explore__cta"><ApplyButton location={`explore_${current}`} size="lg" /></div>
  </div>
</section>

<style>
  .explore__title { margin: 0.5rem 0 1.75rem; }
  .explore__grid { display: grid; gap: 0.75rem; }
  .ecard { position: relative; isolation: isolate; overflow: hidden; display: grid; gap: 0.5rem; align-content: start; min-height: 10rem; padding: 1.4rem; border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--c-line); transition: box-shadow 0.25s var(--ease); }
  .ecard:hover { box-shadow: inset 0 0 0 1.5px var(--c-burgundy); }
  .ecard--ochre { background: var(--c-ochre); } .ecard--coral { background: var(--c-coral); } .ecard--sand { background: var(--c-sand); } .ecard--paper { background: var(--c-white); }
  .ecard .contours { z-index: -1; opacity: 0.7; }
  .ecard__kicker { font-family: var(--f-display); font-size: 0.8125rem; font-weight: 500; color: var(--c-burgundy); }
  .ecard__title { font-family: var(--f-display); font-size: 1.375rem; font-weight: 500; line-height: 1.15; color: var(--c-burgundy); letter-spacing: -0.015em; }
  .ecard__link { margin-top: auto; display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--f-display); font-weight: 500; color: var(--c-burgundy); text-decoration: none; min-height: 2.5rem; }
  .ecard__link::after { content: ''; position: absolute; inset: 0; }
  .explore__cta { margin-top: 2rem; }
  @media (min-width: 60rem) { .explore__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
