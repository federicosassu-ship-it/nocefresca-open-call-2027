---
import ApplyButton from './ApplyButton.astro';
import StatusBadge from './StatusBadge.astro';
import Arrow from './Arrow.astro';
import { heroSources, heroAlt, MOBILE_MQ } from '../lib/hero';
import { status } from '../content/opencall';
import contoursInk from '../generated/contours-ink.svg?url';
import contoursLight from '../generated/contours-light.svg?url';
const h = await heroSources();
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__media">
    <picture>
      <source media={MOBILE_MQ} type="image/avif" srcset={h.mobile.avif} sizes={h.mobile.sizes} />
      <source media={MOBILE_MQ} type="image/webp" srcset={h.mobile.webp} sizes={h.mobile.sizes} />
      <source type="image/avif" srcset={h.desktop.avif} sizes={h.desktop.sizes} />
      <source type="image/webp" srcset={h.desktop.webp} sizes={h.desktop.sizes} />
      <img src={h.fallback} width={h.width} height={h.height} alt={heroAlt} loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero__card" aria-hidden="true">
      <span class="contours" style={`background-image:url(${contoursLight})`}></span>
      <span class="hero__card-kicker">Open Call {status.year}</span>
      <span class="hero__card-nr">Edition Nr. {status.edition}</span>
    </div>
    <p class="hero__caption hide-mobile">Gathering material on the shore</p>
  </div>

  <div class="hero__body">
    <span class="contours hero__contours hide-mobile" style={`background-image:url(${contoursInk})`} aria-hidden="true"></span>
    <div class="hero__top">
      <p class="hero__eyebrow">
        <span class="pill">Open Call {status.year}</span>
        <span class="hero__eyebrow-text">Nocefresca Artist Residency · Milis, Sardinia</span>
      </p>
      <h1 id="hero-title">Your rural artist’s studio in the heart of the Mediterranean.</h1>
    </div>
    <div class="hero__bottom">
      <p class="hero__lead">
        One to three months in Milis, a village of citrus groves in Sardinia. A private studio, a place to live, a guest curator and a small international group of artists.<span class="hide-mobile"> No final outcome required.</span>
      </p>
      <div class="hero__ctas">
        <ApplyButton location="hero" size="lg" />
        <a class="btn btn--ghost btn--lg btn--down" href="#for-you" data-track="secondary_cta_click" data-location="hero">
          <span>Explore<span class="hide-mobile"> the residency</span></span><Arrow dir="down" />
        </a>
      </div>
      <div class="hero__status hide-mobile"><StatusBadge variant="chip" /></div>
    </div>
  </div>
</section>

<style>
  /* ---- mobile first: headline on paper → photo → CTAs over the pale rock ---- */
  .hero { position: relative; display: grid; grid-template-rows: auto minmax(11.5rem, 1fr) auto; min-height: min(100svh, 52rem); isolation: isolate; }
  .hero__body { display: contents; }
  .hero__top { grid-row: 1; grid-column: 1; position: relative; z-index: 1; padding: calc(var(--header-h) + 0.5rem) var(--gutter) 0.75rem; }
  .hero__media { grid-row: 2; grid-column: 1; position: relative; overflow: hidden; background: var(--c-sand); }
  .hero__media :global(picture), .hero__media :global(img) { width: 100%; height: 100%; }
  .hero__media :global(img) { position: absolute; inset: 0; object-fit: cover; object-position: 50% 45%; animation: hero-in 1.6s var(--ease) both; }
  @keyframes hero-in { from { transform: scale(1.06); } to { transform: none; } }
  .hero__media::after { content: ''; position: absolute; inset: 0; background:
      linear-gradient(to bottom, var(--c-paper) 0%, rgb(246 241 231 / 0) 16%),
      linear-gradient(to top, var(--c-paper) 0%, rgb(246 241 231 / 0) 14%); }
  .hero__bottom { grid-row: 3; grid-column: 1; position: relative; z-index: 1; padding: 0.25rem var(--gutter) 1.25rem; }
  .hero__card { display: none; }
  .hero__eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.75rem; font-family: var(--f-display); font-size: 0.875rem; font-weight: 500; color: var(--c-burgundy); margin-bottom: 0.75rem; }
  .hero h1 { font-size: clamp(2.25rem, 1.1rem + 4.4vw, 4.75rem); max-width: 13ch; }
  .hero__lead { font-size: 1.0625rem; line-height: 1.45; max-width: 36ch; color: var(--c-ink); }
  .hero__eyebrow-text { display: none; }
  @media (min-width: 30rem) { .hero__lead { font-size: var(--fs-lead); } .hero__eyebrow-text { display: inline; } }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.1rem; }
  .hero__ctas :global(.btn) { flex: 1 1 auto; }
  .hero__status { margin-top: 1.25rem; }
  @media (min-width: 30rem) { .hero__ctas :global(.btn) { flex: 0 0 auto; } }

  /* ---- desktop: editorial split ---- */
  @media (min-width: 60rem) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr); grid-template-rows: 1fr; min-height: clamp(38rem, calc(100svh - var(--header-h)), 54rem); }
    .hero__media { grid-column: 2; grid-row: 1; }
    .hero__media::after { display: none; }
    .hero__media :global(img) { object-position: 50% 64%; }
    .hero__body { grid-column: 1; grid-row: 1; position: relative; display: flex; flex-direction: column; justify-content: center; gap: 2rem; padding: 2.5rem clamp(2rem, 4vw, 4.5rem) 2.5rem max(var(--gutter), calc((100vw - var(--max)) / 2)); }
    .hero__top, .hero__bottom { position: relative; padding: 0; grid-row: auto; }
    .hero__contours { opacity: 0.9; mask-image: linear-gradient(to right, black 0%, transparent 85%); }
    .hero h1 { max-width: 12.5ch; }
    .hero__lead { font-size: 1.3125rem; max-width: 38ch; }
    .hero__eyebrow-text { display: inline; }
    .hero__card { display: grid; position: absolute; left: 1.5rem; bottom: 1.5rem; min-width: 13.5rem; padding: 1rem 1.25rem 1.1rem; gap: 0.35rem; background: var(--c-ochre); color: var(--c-burgundy); border-radius: var(--radius); overflow: hidden; font-family: var(--f-display); }
    .hero__card-kicker { position: relative; font-size: 0.875rem; font-weight: 500; }
    .hero__card-nr { position: relative; font-size: 1.75rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1; }
    .hero__caption { position: absolute; right: 1.25rem; bottom: 1.25rem; margin: 0; padding: 0.35rem 0.6rem; background: rgb(246 241 231 / 0.88); border-radius: var(--radius); font-family: var(--f-display); font-size: 0.8125rem; color: var(--c-ink); }
  }
  @media (prefers-reduced-motion: reduce) { .hero__media :global(img) { animation: none; } }
</style>
